# Adicione estes valores ao backend/.env. Nunca envie o Access Token ao frontend.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL HTTPS pública: o Mercado Pago não consegue notificar localhost.
MP_NOTIFICATION_URL=https://SEU-DOMINIO/api/payments/notifications/mercadopago

# Confirmacao de compra por e-mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM=seu-email@gmail.com

  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "admin:access": "node scripts/admin-access.cjs",
    "test:admin": "npm run build && node --test test/admin.test.cjs",
    "test:shipping": "npm run build && node --test test/shipping.test.cjs test/admin.test.cjs",
    "test:payments": "npm run build && node --test test/payments.test.cjs",
    "test:checkout": "npm run build && node --test test/checkout-profile.test.cjs test/orders.test.cjs test/payments.test.cjs",
    "test:orders": "npm run build && node --test test/orders.test.cjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node scripts/start-prod.cjs"
